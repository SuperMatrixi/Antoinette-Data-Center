/* ══════════════════════════════════════════════════════════════════
   ANTOINETTE DATA CENTER — style.css
   Design system built on the Golden Ratio (φ ≈ 1.618):
   - Every "rectangle" (card, thumbnail, banner) uses a φ-based
     aspect-ratio or width/height relationship so the grid reads as
     one harmonious family instead of a mix of ad-hoc sizes.
   - Spacing scale is a Fibonacci progression (which converges on φ):
     8 · 13 · 21 · 34 · 55 · 89 · 144
   - Two-column "asymmetric" layouts (Vision, Coach, Webinar) split
     61.8% / 38.2% — the golden section — instead of an even 50/50.
   ══════════════════════════════════════════════════════════════════ */

/* ── 1. RESET ─────────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; scroll-padding-top: 88px; }
body { min-width: 320px; overflow-x: hidden; }
img, svg, video, iframe { display: block; max-width: 100%; }
a { text-decoration: none; color: inherit; }
button, input, textarea, select { font: inherit; color: inherit; }
button { cursor: pointer; background: none; border: none; }
ul, ol { list-style: none; }
h1, h2, h3, h4 { font-family: 'Syne', sans-serif; line-height: 1.15; color: var(--txt); }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
}

/* ── 2. DESIGN TOKENS ─────────────────────────────────────────────── */
:root {
  /* Brand palette */
  --g: #1a8f50;          /* primary green */
  --g-dark: #0d6b3a;      /* deep green */
  --g-light: #22b064;     /* bright green */
  --gold: #D9A441;        /* accent gold */
  --gold-light: #f0c060;
  --navy: #0a1628;        /* dark navy (certification / dark cards) */
  --navy-2: #1a3a5c;

  /* Text */
  --txt: #16241c;
  --mid: #445248;
  --mut: #7c8c82;

  /* Surfaces */
  --bg: #faf9f5;
  --card: #ffffff;
  --bdr: #e6e5dd;

  /* Golden-ratio constant + Fibonacci spacing scale */
  --phi: 1.618;
  --sp-1: 8px;
  --sp-2: 13px;
  --sp-3: 21px;
  --sp-4: 34px;
  --sp-5: 55px;
  --sp-6: 89px;
  --sp-7: 144px;

  /* Radii */
  --r-lg: 22px;
  --r-md: 16px;
  --r-sm: 10px;

  /* Shadows */
  --shadow-sm: 0 2px 10px rgba(22,36,28,.06);
  --shadow-md: 0 10px 30px rgba(22,36,28,.09);
  --shadow-gold: 0 10px 26px rgba(217,164,65,.28);

  --wrap: 1200px;
}

body { font-family: 'Outfit', sans-serif; color: var(--txt); background: var(--bg); font-size: 16px; line-height: 1.6; }

.wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 var(--sp-4); }

section { padding: var(--sp-6) 0; }
section + section { border-top: 1px solid var(--bdr); }
#hero + section { border-top: none; }

/* ── 3. TYPOGRAPHY ────────────────────────────────────────────────── */
h1, .hero-h1 { font-size: clamp(2.1rem, 4.2vw + 1rem, 3.8rem); font-weight: 800; letter-spacing: -.01em; }
h2 { font-size: clamp(1.7rem, 1.2rem + 1.8vw, 2.5rem); font-weight: 800; letter-spacing: -.01em; }
h3 { font-size: 1.15rem; font-weight: 800; }
p { color: var(--mid); }

.lbl {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase;
  color: var(--g); margin-bottom: 10px;
}
.lbl::before { content: ''; width: 21px; height: 2px; background: var(--gold); border-radius: 2px; }

/* ── 4. SCROLL REVEAL ─────────────────────────────────────────────── */
.reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
.reveal.in { opacity: 1; transform: none; }
.rl { opacity: 0; transform: translateX(-34px); transition: opacity .7s ease, transform .7s ease; }
.rl.in { opacity: 1; transform: none; }
.rr { opacity: 0; transform: translateX(34px); transition: opacity .7s ease, transform .7s ease; }
.rr.in { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) {
  .reveal, .rl, .rr { opacity: 1; transform: none; }
}

/* ── 5. BUTTONS ───────────────────────────────────────────────────── */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  padding: 13px 26px; border-radius: 100px; font-weight: 700; font-size: 14px;
  transition: transform .2s ease, box-shadow .2s ease, background .2s ease, color .2s ease;
  white-space: nowrap;
}
.btn:hover { transform: translateY(-2px); }
.btn:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }

.btn-gold { background: linear-gradient(135deg, var(--gold), var(--gold-light)); color: #2a1d05; box-shadow: var(--shadow-gold); }
.btn-gold:hover { box-shadow: 0 14px 32px rgba(217,164,65,.38); }

.btn-green { background: linear-gradient(135deg, var(--g-dark), var(--g)); color: #fff; box-shadow: 0 10px 26px rgba(26,143,80,.28); }
.btn-green:hover { box-shadow: 0 14px 32px rgba(26,143,80,.36); }

.btn-ow { background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,.4); }
.btn-ow:hover { background: rgba(255,255,255,.12); border-color: #fff; }

.btn-og { background: rgba(26,143,80,.08); color: var(--g); border: 1px solid rgba(26,143,80,.25); }
.btn-og:hover { background: rgba(26,143,80,.14); }

/* ── 6. TOPBAR ────────────────────────────────────────────────────── */
#topbar { background: var(--navy); color: #fff; font-size: 12px; }
.tb { max-width: var(--wrap); margin: 0 auto; padding: 8px 21px; display: flex; align-items: center; gap: 21px; }
.tb-left { display: flex; align-items: center; gap: 13px; flex-shrink: 0; }
.live { display: flex; align-items: center; gap: 6px; font-weight: 800; letter-spacing: .08em; color: #ff6b6b; }
.ldot { width: 7px; height: 7px; border-radius: 50%; background: #ff6b6b; animation: pulse 1.6s infinite; }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.35} }
.lbtns { display: flex; gap: 4px; }
.lbtn { padding: 3px 9px; border-radius: 20px; font-size: 11px; font-weight: 700; color: rgba(255,255,255,.5); }
.lbtn.act { background: rgba(255,255,255,.14); color: #fff; }
.tw { flex: 1; overflow: hidden; text-align: center; color: rgba(255,255,255,.65); }
.tt { white-space: nowrap; }
.soc { display: flex; gap: 12px; flex-shrink: 0; }
.soc a { color: rgba(255,255,255,.75); font-weight: 700; }
.soc a:hover { color: var(--gold); }

/* ── 7. NAV ───────────────────────────────────────────────────────── */
#nav { position: sticky; top: 0; z-index: 200; background: rgba(250,249,245,.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--bdr); }
.nav-in { max-width: var(--wrap); margin: 0 auto; padding: 10px 21px; display: flex; align-items: center; gap: 21px; }
.nav-logo { flex-shrink: 0; display: flex; align-items: center; }
.nav-pills { flex: 1; display: flex; justify-content: center; gap: 4px; flex-wrap: wrap; }
.nav-pills a { padding: 8px 14px; border-radius: 100px; font-size: 13.5px; font-weight: 600; color: var(--mid); transition: background .2s, color .2s; }
.nav-pills a:hover { background: rgba(26,143,80,.08); color: var(--g); }
.nav-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
.tyna-btn { display: flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: 100px; background: var(--navy); color: #fff; font-size: 13px; font-weight: 700; }
.tyna-btn:hover { background: #142338; }
.hbg { display: none; flex-direction: column; gap: 5px; padding: 8px; }
.hbg span { width: 22px; height: 2px; background: var(--txt); border-radius: 2px; transition: transform .25s, opacity .25s; }
.mmenu { display: none; flex-direction: column; background: #fff; border-top: 1px solid var(--bdr); padding: 13px 21px; gap: 4px; }
.mmenu.open { display: flex; }
.mmenu a { padding: 11px 4px; font-weight: 600; font-size: 15px; border-bottom: 1px solid var(--bdr); }

/* ── 8. HERO ──────────────────────────────────────────────────────── */
#hero { position: relative; min-height: 640px; display: flex; align-items: center; padding: var(--sp-6) 0; overflow: hidden; border-top: none; color: #fff; }
.hbg-img { position: absolute; inset: 0; background: linear-gradient(135deg, var(--navy) 0%, #123321 55%, var(--g-dark) 100%); background-size: cover; background-position: center; }
.hov { position: absolute; inset: 0; background: radial-gradient(ellipse at 30% 20%, rgba(217,164,65,.14), transparent 60%); }
.hcont { position: relative; z-index: 1; max-width: 720px; }
.eyebrow { display: inline-block; font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--gold); background: rgba(217,164,65,.14); border: 1px solid rgba(217,164,65,.4); padding: 6px 16px; border-radius: 100px; margin-bottom: var(--sp-3); }
.hero-h1 { color: #fff; margin-bottom: var(--sp-3); }
.hero-h1 span { color: var(--gold-light); }
.hero-sub { color: rgba(255,255,255,.78); font-size: 16px; max-width: 560px; margin-bottom: var(--sp-4); }
.hpills { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: var(--sp-4); }
.hpill { font-size: 12.5px; font-weight: 700; color: rgba(255,255,255,.9); background: rgba(255,255,255,.09); border: 1px solid rgba(255,255,255,.18); padding: 6px 14px; border-radius: 100px; }
.hbtns { display: flex; flex-wrap: wrap; gap: 13px; }
.hstats { position: relative; z-index: 1; max-width: var(--wrap); margin: var(--sp-5) auto 0; padding: 0 var(--sp-4); display: grid; grid-template-columns: repeat(3, 1fr); gap: 21px; }
.hsi { text-align: center; }
.hsn { font-family: 'Syne', sans-serif; font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; color: var(--gold-light); }
.hsl { font-size: 12px; color: rgba(255,255,255,.65); font-weight: 600; margin-top: 2px; }

/* ── 9. VISION (golden 61.8 / 38.2 split) ────────────────────────── */
.vgrid { display: grid; grid-template-columns: 1fr 1.618fr; gap: var(--sp-5); align-items: center; }
.vgif { border-radius: var(--r-lg); overflow: hidden; aspect-ratio: 1 / 1.618; box-shadow: var(--shadow-md); }
.vgif img { width: 100%; height: 100%; object-fit: cover; }
.vmetrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-3); margin-top: var(--sp-4); }
.vm { background: var(--card); border: 1px solid var(--bdr); border-radius: var(--r-md); padding: 16px 12px; text-align: center; }
.vmn { font-family: 'Syne', sans-serif; font-size: 1.5rem; font-weight: 800; color: var(--g); }
.vml { font-size: 11.5px; color: var(--mut); font-weight: 600; margin-top: 2px; }

/* ── 10. PROGRAMS ─────────────────────────────────────────────────── */
.pgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-4); }
.pcard {
  background: var(--card); border: 1px solid var(--bdr); border-radius: var(--r-lg);
  overflow: hidden; display: flex; flex-direction: column; box-shadow: var(--shadow-sm);
  transition: transform .25s ease, box-shadow .25s ease;
}
.pcard:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
/* Golden rectangle thumbnail: width:height = φ:1 */
.pthumb { aspect-ratio: var(--phi) / 1; width: 100%; overflow: hidden; }
.pthumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
.pcard:hover .pthumb img { transform: scale(1.05); }
.pbody { padding: var(--sp-4); display: flex; flex-direction: column; flex: 1; }
.ptag { display: inline-flex; align-self: flex-start; font-size: 11.5px; font-weight: 800; letter-spacing: .04em; color: var(--g); background: rgba(26,143,80,.1); padding: 5px 12px; border-radius: 100px; margin-bottom: 10px; }
.ptitle { margin-bottom: 8px; font-size: 1.2rem; }
.pdesc { font-size: 13.5px; line-height: 1.65; margin-bottom: 14px; }
.pfeats { display: flex; flex-direction: column; gap: 8px; margin-bottom: var(--sp-3); flex: 1; }
.pfeats li { font-size: 12.5px; color: var(--mid); line-height: 1.55; padding-left: 18px; position: relative; }
.pfeats li::before { content: '✓'; position: absolute; left: 0; color: var(--g); font-weight: 800; }
.pprice { font-size: 1.4rem; font-weight: 800; color: var(--g); margin-bottom: 14px; }
.pprice span { font-size: 12px; font-weight: 600; color: var(--mut); }
.pcta { margin-top: auto; }

/* Partners / Alumni pill grid — square golden-adjacent logo tiles */
.pgrid-p { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 13px; }
.pitem { text-align: center; border: 1px solid var(--bdr); border-radius: var(--r-md); padding: 18px 12px; transition: border-color .25s, transform .25s; }
.pitem:hover { border-color: var(--gold); transform: translateY(-3px); }
.plogo { width: 100%; aspect-ratio: 1 / 1; max-width: 64px; margin: 0 auto 10px; border-radius: var(--r-sm); overflow: hidden; display: flex; align-items: center; justify-content: center; font-size: 26px; }
.plogo img { width: 100%; height: 100%; object-fit: contain; padding: 8px; }
.pname { font-size: 12.5px; font-weight: 700; }
.pdiv { text-align: center; font-size: 11.5px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--mut); margin-bottom: 13px; }

/* HAi banner + Claude Code certification spotlight are mostly inline-styled in HTML;
   these rules only add responsive behaviour + consistent hover lift. */
.hai-banner, .claude-cert { transition: transform .25s ease; }
.hai-banner:hover, .claude-cert:hover { transform: translateY(-2px); }
@media (max-width: 640px) {
  .hai-banner, .claude-cert { padding: 21px !important; }
  .hai-banner > div:last-child { width: 100%; justify-content: space-between !important; }
}

.shopify-fallback-btn { display: flex !important; }

/* Coach card — golden 61.8/38.2 split, portrait image on the golden minor side */
.coach-card { display: grid; grid-template-columns: 1.618fr 1fr; background: var(--card); border: 1px solid var(--bdr); border-radius: var(--r-lg); overflow: hidden; margin-bottom: var(--sp-4); box-shadow: var(--shadow-sm); }
.coach-body { padding: var(--sp-5); }
.coach-card > img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 1 / var(--phi); }

/* Webinar banner */
.webinar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 21px; background: linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%); border-radius: var(--r-lg); padding: var(--sp-5); margin-bottom: var(--sp-4); }
.webinar-badge { text-align: center; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.2); border-radius: var(--r-md); padding: 16px 26px; flex-shrink: 0; }
.wbn { font-family: 'Syne', sans-serif; font-size: 2rem; font-weight: 800; color: #fff; display: block; }

/* Book-now banner */
.bbn { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px; background: linear-gradient(135deg, var(--gold), var(--gold-light)); border-radius: var(--r-lg); padding: var(--sp-4) var(--sp-5); color: #2a1d05; }
.bbn h3 { color: #2a1d05; font-size: 1.2rem; margin-bottom: 4px; }
.bbn p { color: rgba(42,29,5,.75); font-size: 13.5px; }
.bbn-imgs { display: flex; gap: 13px; align-items: center; flex-shrink: 0; }
.bbn-imgs img { border-radius: var(--r-sm); box-shadow: var(--shadow-sm); }

/* ── 11. SPACES ───────────────────────────────────────────────────── */
.sgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--sp-4); margin-bottom: var(--sp-4); }
.sc { background: var(--card); border: 1px solid var(--bdr); border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-sm); transition: transform .25s; }
.sc:hover { transform: translateY(-4px); }
/* Golden rectangle thumbnail, consistent with .pthumb */
.sci { aspect-ratio: var(--phi) / 1; overflow: hidden; }
.sci img { width: 100%; height: 100%; object-fit: cover; }
.scb { padding: var(--sp-3); }
.scico { font-size: 22px; margin-bottom: 6px; }
.scn { font-weight: 800; font-size: 14.5px; margin-bottom: 3px; }
.scd { font-size: 12px; color: var(--mut); line-height: 1.5; }

/* Gallery carousel — golden rectangle slides, 3 per row on desktop */
.cw { overflow: hidden; border-radius: var(--r-lg); }
.ct { display: flex; gap: 13px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 2px; }
.ct::-webkit-scrollbar { display: none; }
.cs { flex: 0 0 calc((100% - 2 * 13px) / 3); scroll-snap-align: start; border-radius: var(--r-md); overflow: hidden; aspect-ratio: var(--phi) / 1; background: var(--card); border: 1px solid var(--bdr); }
.cs img { width: 100%; height: 100%; object-fit: cover; }
.cctrl { display: flex; align-items: center; justify-content: center; gap: 13px; margin-top: var(--sp-3); }
.cbtn { width: 38px; height: 38px; border-radius: 50%; background: var(--card); border: 1px solid var(--bdr); font-size: 18px; display: flex; align-items: center; justify-content: center; transition: background .2s, border-color .2s; }
.cbtn:hover { background: var(--g); color: #fff; border-color: var(--g); }
.cdots { display: flex; gap: 6px; }
.cdots span { width: 7px; height: 7px; border-radius: 50%; background: var(--bdr); transition: background .2s, transform .2s; }
.cdots span.act { background: var(--g); transform: scale(1.3); }

/* ── 12. VIDEO ────────────────────────────────────────────────────── */
#video { background: var(--navy); }
/* Video frame kept at native 16:9 (not forced to φ) since embedded YouTube requires 16:9 to avoid letterboxing */
.ytmain { aspect-ratio: 16 / 9; border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-md); }
.ytmain iframe { width: 100%; height: 100%; border: 0; }
.ytt { display: grid; grid-template-columns: repeat(3, 1fr); gap: 13px; }
.ythumb { position: relative; aspect-ratio: var(--phi) / 1; border-radius: var(--r-md); overflow: hidden; cursor: pointer; }
.ythumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s; }
.ythumb:hover img { transform: scale(1.06); }
.ythumb-play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(10,22,40,.25); }
.ythumb-play::after { content: '▶'; width: 46px; height: 46px; border-radius: 50%; background: rgba(255,255,255,.92); color: var(--navy); display: flex; align-items: center; justify-content: center; font-size: 15px; padding-left: 3px; }

/* ── 13. MEDIA ────────────────────────────────────────────────────── */
.mgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-4); }
.mc { display: grid; grid-template-columns: 1fr 1.618fr; gap: 18px; background: var(--card); border: 1px solid var(--bdr); border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-sm); }
.mci { aspect-ratio: 1 / var(--phi); overflow: hidden; }
.mci img { width: 100%; height: 100%; object-fit: cover; }
.mcb { padding: 18px 18px 18px 0; display: flex; flex-direction: column; }
.mcs { font-size: 11px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--gold); margin-bottom: 6px; }
.mct { font-size: 15px; margin-bottom: 8px; line-height: 1.35; }
.mce { font-size: 12.5px; line-height: 1.6; margin-bottom: 10px; }
.rm { font-size: 12.5px; font-weight: 800; color: var(--g); margin-top: auto; }

/* ── 14. BLOG — article teaser cards ─────────────────────────────── */
/* "Small to medium, not too big" — 4 tidy cards per row on desktop,
   each framed with a golden rim like a picture frame. */
.blog-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--sp-3); max-width: 1120px; margin: 0 auto; }
.bpost {
  background: var(--card); border-radius: var(--r-md); overflow: hidden;
  display: flex; flex-direction: column; box-shadow: var(--shadow-sm);
  transition: transform .25s, box-shadow .25s, border-color .25s;
  border: 2px solid rgba(217,164,65,.45); /* golden rim */
}
.bpost:hover { transform: translateY(-4px); box-shadow: var(--shadow-gold); border-color: var(--gold); }
/* Golden rectangle cover image, capped so cards stay compact */
.bpost-img { display: block; aspect-ratio: var(--phi) / 1; max-height: 150px; overflow: hidden; }
.bpost-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
.bpost:hover .bpost-img img { transform: scale(1.05); }
/* Fallback tile for a post without a fetched thumbnail yet */
.bpost-img-fallback { display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--navy), var(--navy-2)); font-size: 40px; }
.bpost-body { padding: var(--sp-3); display: flex; flex-direction: column; flex: 1; }
.bpost-meta { display: flex; align-items: center; gap: 10px; font-size: 11px; color: var(--mut); font-weight: 600; margin-bottom: 8px; flex-wrap: wrap; }
.bpost-date { font-weight: 700; color: var(--g); }
.bpost-author { color: var(--mut); }
.bpost-author::before { content: '·'; margin-right: 10px; color: var(--bdr); font-weight: 700; }
.bpost-title { font-size: 1rem; margin-bottom: 8px; line-height: 1.3; }
.bpost-title a { transition: color .2s; }
.bpost-title a:hover { color: var(--g); }
.bpost-excerpt { font-size: 12px; line-height: 1.6; color: var(--mid); margin-bottom: 12px; }
.bpost-cta { margin-top: auto; align-self: flex-start; display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 800; color: var(--g); padding-bottom: 2px; border-bottom: 2px solid transparent; transition: border-color .2s, gap .2s; }
.bpost-cta:hover { border-color: var(--g); gap: 10px; }

.blog-more { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 13px; background: var(--card); border: 1px dashed var(--bdr); border-radius: var(--r-md); padding: 16px 21px; margin-top: var(--sp-4); }
.blog-more-txt { font-size: 13px; font-weight: 600; color: var(--mut); }

/* ── 15. FAQ ──────────────────────────────────────────────────────── */
#faq .fgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 13px; }
#faq .fi { background: var(--card); border: 1px solid var(--bdr); border-radius: var(--r-md); overflow: hidden; }
#faq .fq { display: flex; align-items: center; justify-content: space-between; gap: 13px; padding: 17px 20px; font-weight: 700; font-size: 14.5px; cursor: pointer; }
#faq .fa-arr { flex-shrink: 0; transition: transform .25s; color: var(--g); font-size: 11px; }
#faq .fi.open .fa-arr { transform: rotate(180deg); }
#faq .fa { max-height: 0; overflow: hidden; transition: max-height .3s ease, padding .3s ease; font-size: 13.5px; color: var(--mid); line-height: 1.65; padding: 0 20px; }
#faq .fi.open .fa { max-height: 300px; padding: 0 20px 18px; }

/* ── 16. CONTACT ──────────────────────────────────────────────────── */
.cgrid { display: grid; grid-template-columns: 1fr 1.618fr; gap: var(--sp-5); align-items: start; }
.cdetails { display: flex; flex-direction: column; gap: 16px; margin: var(--sp-3) 0 var(--sp-4); }
.citem { display: flex; gap: 13px; align-items: flex-start; }
.cico { width: 38px; height: 38px; border-radius: 50%; background: rgba(26,143,80,.1); display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
.ctext { display: flex; flex-direction: column; gap: 2px; font-size: 13.5px; }
.ctext strong { font-size: 13px; }
.mapw { border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--bdr); }
.cform { background: var(--card); border: 1px solid var(--bdr); border-radius: var(--r-lg); padding: var(--sp-5); box-shadow: var(--shadow-sm); }
.cform h3 { margin-bottom: var(--sp-3); }
.fg { margin-bottom: 14px; }
.fl { display: block; font-size: 12.5px; font-weight: 700; margin-bottom: 6px; }
.fi2, .fta { width: 100%; padding: 12px 14px; border: 1px solid var(--bdr); border-radius: var(--r-sm); font-size: 14px; background: var(--bg); transition: border-color .2s; }
.fi2:focus, .fta:focus { outline: none; border-color: var(--g); }
.fta { min-height: 110px; resize: vertical; }

/* ── 17. JOIN ─────────────────────────────────────────────────────── */
#join { background: linear-gradient(135deg, var(--navy) 0%, var(--g-dark) 130%); color: #fff; text-align: center; }
.jcont h2 { color: #fff; margin-bottom: 8px; }
.jcont > p { color: rgba(255,255,255,.72); margin-bottom: var(--sp-4); }
.jbtns { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 16px; margin-bottom: var(--sp-4); }
.wabtn { display: inline-flex; align-items: center; gap: 8px; padding: 13px 24px; border-radius: 100px; background: #fff; color: var(--g-dark); font-weight: 800; font-size: 14px; transition: transform .2s; }
.wabtn:hover { transform: translateY(-2px); }
/* Leaner, wider Substack subscribe embed (compact bar instead of a tall box) */
.substack-embed-wrap { width: 100%; max-width: 480px; border-radius: var(--r-md); overflow: hidden; box-shadow: var(--shadow-md); }
.substack-embed { width: 100%; height: 150px; display: block; border-radius: var(--r-md); }
.jsoc { display: flex; flex-wrap: wrap; justify-content: center; gap: 21px; font-size: 13px; font-weight: 600; color: rgba(255,255,255,.7); }
.jsoc a:hover { color: var(--gold-light); }

/* ── 18. PARTNERS section heading spacing handled by generic .lbl/.wrap ── */

/* ── 19. FOOTER ───────────────────────────────────────────────────── */
footer { background: var(--navy); color: rgba(255,255,255,.75); padding: var(--sp-6) 0 var(--sp-4); }
footer .fgrid { display: grid; grid-template-columns: 1.618fr 1fr 1fr 1fr; gap: var(--sp-4); margin-bottom: var(--sp-5); }
.fbrand h3 { color: #fff; margin-bottom: 10px; }
.fbrand p { color: rgba(255,255,255,.55); font-size: 13px; line-height: 1.7; margin-bottom: 16px; }
.fsoc { display: flex; gap: 10px; }
.fsoc a { width: 34px; height: 34px; border-radius: 50%; background: rgba(255,255,255,.08); display: flex; align-items: center; justify-content: center; font-weight: 700; transition: background .2s; }
.fsoc a:hover { background: var(--gold); color: var(--navy); }
.fcol h4 { color: #fff; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 13px; }
.fcol ul { display: flex; flex-direction: column; gap: 9px; }
.fcol a { font-size: 13px; color: rgba(255,255,255,.6); transition: color .2s; }
.fcol a:hover { color: var(--gold-light); }
.fdiscl { font-size: 11.5px; color: rgba(255,255,255,.45); line-height: 1.7; border-top: 1px solid rgba(255,255,255,.1); padding-top: var(--sp-3); margin-bottom: var(--sp-3); }
.fbot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; font-size: 12px; color: rgba(255,255,255,.4); }
.fbot-links { display: flex; gap: 16px; }
.fbot-links a:hover { color: #fff; }

/* ── 20. FLOATING ACTIONS ─────────────────────────────────────────── */
.fwa { position: fixed; right: 21px; bottom: 21px; width: 55px; height: 55px; border-radius: 50%; background: #25d366; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 26px; box-shadow: 0 8px 22px rgba(37,211,102,.4); z-index: 150; transition: transform .2s; }
.fwa:hover { transform: scale(1.08); }
.fnl { position: fixed; right: 21px; bottom: 89px; padding: 11px 18px; border-radius: 100px; background: var(--navy); color: #fff; font-size: 12.5px; font-weight: 700; box-shadow: var(--shadow-md); z-index: 150; }

/* ── 21. TYNA CHATBOT ─────────────────────────────────────────────── */
#tbub { position: fixed; left: 21px; bottom: 21px; width: 58px; height: 58px; border-radius: 50%; cursor: pointer; box-shadow: var(--shadow-md); z-index: 150; }
.tico { width: 100%; height: 100%; border-radius: 50%; overflow: hidden; border: 2px solid var(--gold); }
.tico img { width: 100%; height: 100%; object-fit: cover; }
.tbadge { position: absolute; top: -3px; right: -3px; width: 20px; height: 20px; border-radius: 50%; background: #ff6b6b; color: #fff; font-size: 11px; font-weight: 800; display: flex; align-items: center; justify-content: center; }

#twin { display: none; position: fixed; left: 21px; bottom: 89px; width: 340px; max-width: calc(100vw - 42px); height: 480px; max-height: 70vh; background: #fff; border-radius: var(--r-lg); box-shadow: var(--shadow-md); z-index: 250; flex-direction: column; overflow: hidden; }
#twin.open { display: flex; }
.thead { display: flex; align-items: center; gap: 10px; padding: 14px 16px; background: var(--navy); color: #fff; }
.tav { width: 36px; height: 36px; border-radius: 50%; overflow: hidden; flex-shrink: 0; }
.tav img { width: 100%; height: 100%; object-fit: cover; }
.tinf { flex: 1; }
.tinf h4 { color: #fff; font-size: 14px; }
.tinf span { font-size: 11px; color: rgba(255,255,255,.6); }
.tlangs { display: flex; gap: 4px; }
.tlang { padding: 3px 8px; border-radius: 100px; font-size: 10.5px; font-weight: 700; color: rgba(255,255,255,.5); }
.tlang.act { background: rgba(255,255,255,.15); color: #fff; }
.tmsgs { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; background: var(--bg); }
.tsugg { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 16px 10px; }
.tsug { padding: 6px 12px; border-radius: 100px; background: rgba(26,143,80,.08); color: var(--g); font-size: 11.5px; font-weight: 600; }
.tia { display: flex; gap: 8px; padding: 12px; border-top: 1px solid var(--bdr); }
.tinput { flex: 1; padding: 10px 14px; border: 1px solid var(--bdr); border-radius: 100px; font-size: 13px; }
.tinput:focus { outline: none; border-color: var(--g); }
.tsend { width: 38px; height: 38px; border-radius: 50%; background: var(--g); color: #fff; flex-shrink: 0; }

/* ── 22. GDPR BANNER ──────────────────────────────────────────────── */
#gdpr { display: none; position: fixed; left: 21px; bottom: 21px; width: 360px; max-width: calc(100vw - 42px); background: var(--navy); color: #fff; border-radius: var(--r-lg); padding: var(--sp-4); box-shadow: var(--shadow-md); z-index: 300; }
#gdpr.open { display: block; }
.gdpr-t { font-weight: 800; font-size: 14.5px; margin-bottom: 8px; }
.gdpr-p { font-size: 12.5px; color: rgba(255,255,255,.7); line-height: 1.6; margin-bottom: 13px; }
.gdpr-opts { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }
.gdpr-opt { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: rgba(255,255,255,.8); }
.gdpr-bs { display: flex; flex-direction: column; gap: 8px; }
.gdpr-acc, .gdpr-rej { padding: 11px; border-radius: var(--r-sm); font-weight: 700; font-size: 13px; }
.gdpr-acc { background: var(--g); color: #fff; }
.gdpr-rej { background: transparent; color: rgba(255,255,255,.6); border: 1px solid rgba(255,255,255,.2); }

/* ── 23. NEWSLETTER MODAL ─────────────────────────────────────────── */
#nlmod { display: none; position: fixed; inset: 0; background: rgba(10,22,40,.6); z-index: 400; align-items: center; justify-content: center; padding: 21px; }
#nlmod.open { display: flex; }
.nlcard { position: relative; width: 100%; max-width: 420px; background: #fff; border-radius: var(--r-lg); padding: var(--sp-5); text-align: center; }
.nlx { position: absolute; top: 13px; right: 13px; width: 30px; height: 30px; border-radius: 50%; background: var(--bg); font-size: 14px; }
.nlico { font-size: 34px; margin-bottom: 10px; }
.nlcard h2 { font-size: 1.3rem; margin-bottom: 8px; }
.nlcard p { font-size: 13.5px; margin-bottom: var(--sp-4); }
.nlinput { width: 100%; padding: 12px 16px; border: 1px solid var(--bdr); border-radius: var(--r-sm); margin-bottom: 10px; font-size: 14px; }
.nlsub { width: 100%; padding: 13px; border-radius: 100px; background: linear-gradient(135deg, var(--g-dark), var(--g)); color: #fff; font-weight: 800; font-size: 14px; }
.nlnote { font-size: 11.5px; color: var(--mut); margin-top: 12px; }

/* ── 24. RESPONSIVE ───────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .pgrid, .mgrid { grid-template-columns: 1fr; }
  .cgrid { grid-template-columns: 1fr; }
  .vgrid { grid-template-columns: 1fr; }
  .vgif { aspect-ratio: var(--phi) / 1; max-width: 480px; margin: 0 auto; }
  .coach-card { grid-template-columns: 1fr; }
  .coach-card > img { aspect-ratio: var(--phi) / 1; order: -1; }
  footer .fgrid { grid-template-columns: 1fr 1fr; }
  .cs { flex: 0 0 calc((100% - 13px) / 2); }
}

@media (max-width: 900px) {
  .nav-pills { display: none; }
  .hbg { display: flex; }
  .hstats { grid-template-columns: repeat(3, 1fr); }
  .sgrid { grid-template-columns: repeat(2, 1fr); }
  .ytt { grid-template-columns: 1fr; }
  #faq .fgrid { grid-template-columns: 1fr; }
  .bbn { flex-direction: column; text-align: center; }
  .webinar { flex-direction: column; text-align: center; }
  section { padding: var(--sp-5) 0; }
}

@media (max-width: 640px) {
  .wrap { padding: 0 var(--sp-3); }
  .hero-h1 { font-size: 2rem; }
  .hbtns, .hpills { justify-content: center; }
  .hstats { grid-template-columns: 1fr; gap: 13px; }
  .sgrid { grid-template-columns: 1fr; }
  footer .fgrid { grid-template-columns: 1fr; gap: 26px; }
  .mc { grid-template-columns: 1fr; }
  .mci { aspect-ratio: var(--phi) / 1; }
  .mcb { padding: 16px; }
  .cs { flex: 0 0 100%; }
  .blog-grid { grid-template-columns: 1fr; }
  .blog-more { flex-direction: column; text-align: center; }
  .tb { flex-wrap: wrap; gap: 8px; }
  .tw { order: 3; width: 100%; }
  #twin { left: 13px; right: 13px; width: auto; }
  .substack-embed-wrap { max-width: 100%; }
}

/* ── 25. ACCESSIBILITY ────────────────────────────────────────────── */
a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible {
  outline: 2px solid var(--g); outline-offset: 2px;
}v
